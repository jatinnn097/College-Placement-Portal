<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Add Company</title>

    <link
        rel="stylesheet"
        href="/add.css"
    >

    <link rel="stylesheet" href="/theme.css">
</head>

<body>

<div class="add-company-container">

    <h1>Add Company</h1>

    <form
        action="/company/add"
        method="POST"
    >

         <!-- COMPANY NAME -->

         <label>
             Company Name
         </label>

         <input
             type="text"
             name="company"
             placeholder="Enter company name"
             required
         >

         <br><br>


         <!-- HR EMAIL -->

         <label>
             HR Email
         </label>

         <input
             type="email"
             name="email"
             placeholder="Enter HR email"
             required
         >

         <br><br>


         <!-- JOB ROLE -->

         <label>
             Job Role
         </label>

         <input
             type="text"
             name="role"
             placeholder="Example: Software Developer"
             required
         >
         <br><br>

   <!-- PACKAGE -->

   <label>
       Package (LPA)
   </label>

   <input
       type="text"
       name="package"
       placeholder="Example: 8 LPA"
       required
   >

   <br><br>


   <!-- MINIMUM CGPA -->

   <label>
       Minimum CGPA
   </label>

   <input
       type="number"
       step="0.01"
       name="mincgpa"
       placeholder="Example: 7.5"
       min="0"
       max="10"
       required
   >

   <br><br>


   <!-- DEADLINE -->

   <label>
       Application Deadline
   </label>

   <input
       type="date"
       name="deadline"
       required
   >

   <br><br>


   <!-- DESCRIPTION -->

   <label>
       Company / Job Description
   </label>

   <textarea
       name="description"
       placeholder="Enter company description, job role and required skills..."
       required
   ></textarea>

   <br><br>


   <!-- BUTTON -->

   <button type="submit">
       Add Company
   </button>

</form>


<!-- LINKS -->

<div class="company-links">

   <a href="/companies">
       View Companies
   </a>
   <a href="/admin">

              Back To Dashboard
          </a>

   </div>

</div>

</body>

</html>

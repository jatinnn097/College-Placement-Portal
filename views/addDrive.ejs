<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Add Placement Drive</title>

    <link
        rel="stylesheet"
        href="/add.css"
    >

</head>

<body>

<div class="add-company-container">

    <h1>Add Placement Drive</h1>

    <form action="/drive/add" method="POST">

        <!-- COMPANY -->

        <label>
            Company Name
        </label>

        <input
            type="text"
            name="company"
            placeholder="Enter company name"
            required
        >

        <br><br>


        <!-- JOB ROLE -->

        <label>
            Job Role
        </label>

        <input
            type="text"
            name="role"
            placeholder="Example: Software Developer"
            required
        >

        <br><br>


        <!-- MINIMUM CGPA -->

        <label>
            Minimum CGPA
        </label>

        <input
            type="number"
            step="0.01"
            name="mincgpa"
            placeholder="Example: 7.5"
            min="0"
            max="10"
            required
        >

        <br><br>


        <!-- PACKAGE -->

        <label>
            Package
        </label>

        <input
            type="text"
            name="package"
            placeholder="Example: 8 LPA"
            required
        >

        <br><br>


        <!-- INTERVIEW DATE -->

        <label>
            Interview Date
        </label>

        <input
            type="date"
            name="interviewDate"
            required
        >

        <br><br>


        <!-- APPLICATION DEADLINE -->

        <label>
            Application Deadline
        </label>

        <input
            type="date"
            name="deadline"
            required
        >

        <br><br>


        <!-- JOB DESCRIPTION -->

        <label>
            Job Description / Required Skills
        </label>

        <textarea
            name="description"
            placeholder="Enter job description and required skills...

Example:

Software Developer

Required Skills:
C++
Java
Python
MongoDB
React
Node.js
SQL
Git"
            required
        ></textarea>

        <br><br>


        <!-- SUBMIT -->

        <button type="submit">
            Add Placement Drive
        </button>

    </form>


    <!-- LINKS -->

    <div class="company-links">

        <a href="/drives">
            View Placement Drives
        </a>

        <a href="/admin">
            Back To Dashboard
        </a>

    </div>

</div>

</body>

</html>
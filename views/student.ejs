<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Details</title>

    <link rel="stylesheet" href="/student.css">

</head>


<body>


<div class="student-details-container">



    <h1>
        Student Profile
    </h1>




    <!-- PHOTO -->

    <div class="student-photo-card">

        <img 
            src="/photo/<%= student.usn %>"
            alt="Student Photo"
        >

    </div>




    <!-- BASIC DETAILS -->

    <div class="detail-section">


        <h2>
            Personal Details
        </h2>


        <div class="details-grid">


            <p>
                <b>USN:</b>
                <%= student.usn %>
            </p>


            <p>
                <b>Name:</b>
                <%= student.fullname %>
            </p>


            <p>
                <b>Email:</b>
                <%= student.email %>
            </p>


            <p>
                <b>Branch:</b>
                <%= student.branch %>
            </p>



        </div>


    </div>





    <!-- ACADEMIC DETAILS -->


    <div class="detail-section">


        <h2>
            Academic Details
        </h2>


        <div class="details-grid">


            <p>
                <b>Semester:</b>
                <%= student.sem %>
            </p>


            <p>
                <b>CGPA:</b>
                <%= student.cgpa %>
            </p>


            <p>
                <b>Graduation Year:</b>
                2028
            </p>


            <p>
                <b>Status:</b>
                Active
            </p>


        </div>


    </div>






    <!-- PLACEMENT DETAILS -->


    <div class="detail-section">


        <h2>
            Placement Details
        </h2>



        

    </div>




    <div class="student-links">


        <a href="/admin">
            Back To Dashboard
        </a>


        <a href="/edit/<%= student.usn %>">
            Edit Student
        </a>


    </div>



</div>


</body>

</html>
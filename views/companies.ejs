<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <meta 
        name="viewport" 
        content="width=device-width, initial-scale=1.0"
    >

    <title>Companies</title>

    <link rel="stylesheet" href="/edit.css">

</head>


<body>


<div class="company-page-container">


    <h1>Companies List</h1>



    <div class="top-links">

        <a href="/company/add">
            + Add Company
        </a>


        <a href="/admin">
            Dashboard
        </a>

    </div>



    <div class="table-container">


        <table>


            <thead>

            <tr>

                <th>Company</th>

                <th>Email</th>

                <th>Role</th>

                <th>Package</th>

                <th>Min CGPA</th>

                <th>Deadline</th>

                <th>Actions</th>

            </tr>

            </thead>



            <tbody>


            <% data.forEach(company => { %>


            <tr>


                <td>
                    <%= company.company %>
                </td>


                <td>
                    <%= company.email %>
                </td>


                <td>
                    <%= company.role %>
                </td>


                <td>
                    <%= company.package %>
                </td>


                <td>
                    <%= company.mincgpa %>
                </td>


                <td>
                    <%= company.deadline %>
                </td>



                <td class="action-buttons">


                    <a 
                    class="edit-btn"
                    href="/company/edit/<%= company._id %>">
                        Edit
                    </a>



                    <a 
                    class="delete-btn"
                    href="/company/delete/<%= company._id %>"
                    onclick="return confirm('Delete this company?')">
                        Delete
                    </a>


                </td>


            </tr>


            <% }) %>


            </tbody>


        </table>


    </div>




    <div class="hr-box">


        <h2>
            HR Login Credentials
        </h2>


        <p>
            <b>Email:</b> Company HR Email
        </p>


        <p>
            <b>Password:</b> company123
        </p>


    </div>



</div>



</body>

</html>
<!DOCTYPE html>

<html>
<head>
    <title>HR Dashboard</title>
        <link rel="stylesheet" href="/hrDashboard.css">

</head>

<body>

<h1>HR Dashboard</h1>

<a href="/logout">Logout</a>

<hr>

<h2>Interview Slots</h2>

<a href="/interview-slots/add">
    Add Interview Slot
</a>

<hr>

<h2>Applications</h2>

<% if (data && data.length > 0) { %>

<table border="1" cellpadding="10" cellspacing="0">

```
<tr>
    <th>USN</th>
    <th>Name</th>
    <th>Email</th>
    <th>Role</th>
    <th>Status</th>
    <th>ATS Score</th>
    <th>Actions</th>
</tr>

<% data.forEach(function(student) { %>

<tr>

    <td>
        <%= student.usn %>
    </td>

    <td>
        <%= student.name %>
    </td>

    <td>
        <%= student.email %>
    </td>

    <td>
        <%= student.role %>
    </td>

    <td>
        <%= student.status %>
    </td>

    <td>

        <% if (student.atsScore !== undefined) { %>

            <%= student.atsScore %>%

        <% } else { %>

            Not Scanned

        <% } %>

    </td>

    <td>

        <a href="/shortlist/<%= student._id %>">
            Shortlist
        </a>

        |

        <a href="/reject/<%= student._id %>">
            Reject
        </a>

        |

        <a href="/select/<%= student._id %>">
            Select
        </a>

        <br><br>

        <a href="/ats/scan/<%= student.usn %>/<%= student.driveId %>">
            Scan Resume
        </a>

    </td>

</tr>


<!-- ATS DETAILS -->

<tr>

    <td colspan="7">

        <% if (student.atsScore !== undefined) { %>

            <strong>ATS Result:</strong>
            <%= student.atsResult %>

            <br><br>

            <strong>Matched Skills:</strong>

            <% if (
                student.matchedSkills &&
                student.matchedSkills.length > 0
            ) { %>

                <%= student.matchedSkills.join(", ") %>

            <% } else { %>

                None

            <% } %>

            <br><br>

            <strong>Missing Skills:</strong>

            <% if (
                student.missingSkills &&
                student.missingSkills.length > 0
            ) { %>

                <%= student.missingSkills.join(", ") %>

            <% } else { %>

                None

            <% } %>

        <% } else { %>

            Resume has not been scanned.

        <% } %>

    </td>

</tr>


<!-- INTERVIEW DETAILS -->

<% if (student.status === "Interview Scheduled") { %>

<tr>

    <td colspan="7">

        <strong>Interview Scheduled</strong>

        <br><br>

        Date:
        <%= student.interviewDate %>

        <br>

        Time:
        <%= student.interviewTime %>

        <br>

        Mode:
        <%= student.interviewMode %>

    </td>

</tr>

<% } %>


<% }); %>
```

</table>

<% } else { %>

<p>
    No students have applied for your placement drives yet.
</p>

<% } %>

</body>
</html>

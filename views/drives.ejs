<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Placement Drives</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>
        /* =========================================
           TOKENS
        ========================================= */

        :root {
            --ink: #0B1F3A;
            --ink-2: #12294A;

            --parchment: #F6F4EE;
            --paper: #FFFFFF;

            --brass: #AD8A54;
            --brass-light: #E4D6B8;

            --slate: #5B6B7C;

            --hairline: #E2DDD0;

            --ledger-green: #1F6E45;
            --error: #9A2E2E;

            --font-display: "Fraunces", "Iowan Old Style", Georgia, serif;
            --font-body: "Inter", "Segoe UI", Arial, sans-serif;
        }

        /* =========================================
           GLOBAL
        ========================================= */

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            font-family: var(--font-body);
            color: var(--ink);

            background:
                linear-gradient(
                    135deg,
                    var(--parchment),
                    #eeeade
                );

            padding: 40px 20px;
        }

        /* =========================================
           MAIN CONTAINER
        ========================================= */

        .container {
            width: 95%;
            max-width: 1200px;

            margin: 0 auto;

            background: var(--paper);

            padding: 35px;

            border-radius: 18px;

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.15);
        }

        /* =========================================
           TITLE
        ========================================= */

        h1 {
            margin: 0 0 30px;

            text-align: center;

            color: var(--ink);

            font-family: var(--font-display);

            font-size: 34px;
            font-weight: 600;

            letter-spacing: 0.5px;
        }

        /* =========================================
           TOP LINKS
        ========================================= */

        .top-links {
            display: flex;

            justify-content: space-between;
            align-items: center;

            gap: 15px;

            margin-bottom: 25px;
        }

        .top-links a {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-width: 150px;

            padding: 12px 25px;

            background: var(--ink);

            color: white;

            border-radius: 8px;

            text-decoration: none;

            font-size: 14px;
            font-weight: 700;

            transition: all 0.25s ease;

            box-shadow:
                0 4px 12px rgba(11, 31, 58, 0.15);
        }

        .top-links a:hover {
            background: var(--brass);

            transform: translateY(-2px);

            box-shadow:
                0 7px 18px rgba(173, 138, 84, 0.25);
        }

        /* =========================================
           TABLE CONTAINER
        ========================================= */

        .table-container {
            width: 100%;

            overflow-x: auto;

            border-radius: 12px;

            border: 1px solid var(--hairline);
        }

        /* =========================================
           TABLE
        ========================================= */

        table {
            width: 100%;

            min-width: 800px;

            border-collapse: collapse;

            background: var(--paper);
        }

        /* =========================================
           TABLE HEADER
        ========================================= */

        th {
            padding: 15px 14px;

            background: var(--ink);

            color: white;

            text-align: center;

            font-size: 13px;

            font-weight: 700;

            letter-spacing: 0.4px;

            white-space: nowrap;
        }

        /* =========================================
           TABLE BODY
        ========================================= */

        td {
            padding: 14px;

            text-align: center;

            color: var(--slate);

            font-size: 14px;

            border-bottom: 1px solid var(--hairline);

            vertical-align: middle;
        }

        tbody tr {
            transition: background 0.2s ease;
        }

        tbody tr:hover {
            background: var(--parchment);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        /* Company */

        td:first-child {
            color: var(--ink);

            font-weight: 700;
        }

        /* Role */

        td:nth-child(2) {
            color: var(--ink);
            font-weight: 600;
        }

        /* Package */

        td:nth-child(3) {
            color: var(--ledger-green);

            font-weight: 700;
        }

        /* Minimum CGPA */

        td:nth-child(4) {
            color: var(--brass);

            font-weight: 700;
        }

        /* =========================================
           NO DATA
        ========================================= */

        .no-data {
            padding: 30px !important;

            text-align: center;

            color: var(--slate);

            font-size: 16px;

            font-weight: 500;

            background: var(--parchment);
        }

        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 700px) {

            body {
                padding: 20px 10px;
            }

            .container {
                width: 100%;

                padding: 25px 15px;

                border-radius: 14px;
            }

            h1 {
                font-size: 26px;

                margin-bottom: 25px;
            }

            .top-links {
                flex-direction: column;

                align-items: stretch;

                gap: 12px;
            }

            .top-links a {
                width: 100%;

                min-width: 0;
            }

            .table-container {
                border-radius: 10px;
            }

            th {
                padding: 13px 12px;

                font-size: 12px;
            }

            td {
                padding: 12px;

                font-size: 13px;
            }
        }

        /* =========================================
           SMALL MOBILE
        ========================================= */

        @media (max-width: 450px) {

            .container {
                padding: 20px 10px;
            }

            h1 {
                font-size: 23px;
            }

            .top-links a {
                padding: 11px 15px;

                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- PAGE TITLE -->

        <h1>
            ■ Placement Drives
        </h1>


        <!-- TOP BUTTONS -->

        <div class="top-links">

            <a href="/drive/add">
                ■ Add Drive
            </a>

            <a href="/admin">
                ← Dashboard
            </a>

        </div>


        <!-- TABLE -->

        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>
                            Company
                        </th>

                        <th>
                            Role
                        </th>

                        <th>
                            Package
                        </th>

                        <th>
                            Minimum CGPA
                        </th>

                        <th>
                            Interview Date
                        </th>

                        <th>
                            Deadline
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% if (data && data.length > 0) { %>

                        <% data.forEach(drive => { %>

                            <tr>

                                <td>
                                    <%= drive.company %>
                                </td>

                                <td>
                                    <%= drive.role %>
                                </td>

                                <td>
                                    <%= drive.package %>
                                </td>

                                <td>
                                    <%= drive.mincgpa %>
                                </td>

                                <td>
                                    <%= drive.interviewDate %>
                                </td>

                                <td>
                                    <%= drive.deadline %>
                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>

                            <td colspan="6" class="no-data">
                                No Placement Drives Available
                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

</body>

</html>
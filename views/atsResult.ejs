<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ATS Resume Scanner</title>

    <style>
        /* =========================================
           TOKENS
        ========================================= */

        :root {
            --ink: #0B1F3A;
            --ink-2: #12294A;
            --parchment: #F6F4EE;
            --paper: #FFFFFF;
            --brass: #AD8A54;
            --brass-light: #E4D6B8;
            --slate: #5B6B7C;
            --hairline: #E2DDD0;
            --hairline-dark: rgba(255, 255, 255, 0.14);
            --ledger-green: #1F6E45;
            --error: #9A2E2E;

            --font-display: "Fraunces", "Iowan Old Style", Georgia, serif;
            --font-body: "Inter", "Segoe UI", Arial, sans-serif;
        }

        /* Google Fonts */
        @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap');

        /* =========================================
           GLOBAL
        ========================================= */

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;

            font-family: var(--font-body);
            color: var(--ink);

            background:
                linear-gradient(
                    rgba(10, 30, 55, 0.92),
                    rgba(10, 30, 55, 0.92)
                ),
                url("https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1600&q=80");

            background-size: cover;
            background-position: center;
            background-attachment: fixed;

            padding: 40px 20px;
        }

        /* =========================================
           MAIN CONTAINER
        ========================================= */

        .container {
            width: 100%;
            max-width: 1000px;

            margin: 0 auto;

            background: var(--paper);

            padding: 40px;

            border-radius: 20px;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.35);
        }

        /* =========================================
           HEADINGS
        ========================================= */

        h1,
        h2 {
            font-family: var(--font-display);
            color: var(--ink);
        }

        h1 {
            text-align: center;

            font-size: 36px;

            margin-bottom: 30px;
        }

        h2 {
            font-size: 22px;

            margin-bottom: 15px;
        }

        hr {
            border: none;

            height: 1px;

            background: var(--hairline);

            margin: 30px 0;
        }

        /* =========================================
           STUDENT INFORMATION
        ========================================= */

        .student-info {
            background: var(--parchment);

            padding: 25px;

            border-radius: 15px;

            border-left: 6px solid var(--brass);

            box-shadow:
                0 5px 15px rgba(0, 0, 0, 0.05);
        }

        .student-info h2 {
            margin-top: 0;

            margin-bottom: 18px;
        }

        .student-info p {
            font-size: 16px;

            color: var(--slate);

            margin: 10px 0;
        }

        .student-info strong {
            color: var(--ink);
        }

        /* =========================================
           ATS SCORE
        ========================================= */

        .score-box {
            text-align: center;

            margin: 35px 0;

            padding: 35px;

            border-radius: 20px;

            background:
                linear-gradient(
                    135deg,
                    #eff6ff,
                    #ffffff
                );

            border: 1px solid #e2e8f0;

            box-shadow:
                0 8px 25px rgba(0, 0, 0, 0.08);
        }

        .score-label {
            color: var(--slate);

            font-size: 15px;

            margin-bottom: 5px;
        }

        .score {
            font-size: 55px;

            font-weight: 800;

            color: var(--brass);

            line-height: 1.2;
        }

        .result {
            margin-top: 15px;

            font-size: 28px;

            font-weight: bold;

            color: var(--ledger-green);
        }

        /* =========================================
           SECTIONS
        ========================================= */

        .section {
            margin-top: 30px;

            padding: 25px;

            border-radius: 15px;

            border: 1px solid var(--hairline);

            background: var(--paper);

            box-shadow:
                0 5px 20px rgba(0, 0, 0, 0.06);
        }

        .section h2 {
            margin-top: 0;

            padding-bottom: 12px;

            border-bottom: 2px solid var(--hairline);
        }

        .section p {
            color: var(--slate);

            font-size: 16px;

            margin-top: 10px;
        }

        /* =========================================
           SKILLS
        ========================================= */

        .skills {
            display: flex;

            flex-wrap: wrap;

            gap: 12px;

            margin-top: 20px;
        }

        .skill {
            display: inline-flex;

            align-items: center;

            padding: 10px 18px;

            border-radius: 25px;

            font-weight: bold;

            font-size: 14px;
        }

        /* Resume Skills */

        .resume-skill {
            background: var(--brass-light);

            color: var(--brass);
        }

        /* Required Skills */

        .required-skill {
            background: #fef3c7;

            color: #8a6518;
        }

        /* Matched Skills */

        .matched {
            background: #dcfce7;

            color: #166534;
        }

        /* Missing Skills */

        .missing {
            background: #fee2e2;

            color: #991b1b;
        }

        /* =========================================
           BACK BUTTON
        ========================================= */

        .back {
            display: inline-block;

            margin-top: 30px;

            padding: 14px 28px;

            background: var(--ink);

            color: white;

            text-decoration: none;

            border-radius: 10px;

            font-weight: bold;

            transition: 0.3s;

            border: none;
        }

        .back:hover {
            background: var(--brass);

            color: white;

            transform: translateY(-2px);

            box-shadow:
                0 6px 15px rgba(0, 0, 0, 0.18);
        }

        /* =========================================
           SCORE COLOR STATES
        ========================================= */

        .score.high {
            color: var(--ledger-green);
        }

        .score.medium {
            color: var(--brass);
        }

        .score.low {
            color: var(--error);
        }

        /* =========================================
           RESPONSIVE
        ========================================= */

        @media (max-width: 700px) {

            body {
                padding: 20px 10px;
            }

            .container {
                padding: 25px 20px;

                border-radius: 15px;
            }

            h1 {
                font-size: 28px;

                margin-bottom: 25px;
            }

            h2 {
                font-size: 20px;
            }

            .student-info {
                padding: 20px;
            }

            .score-box {
                padding: 25px 15px;

                margin: 25px 0;
            }

            .score {
                font-size: 40px;
            }

            .result {
                font-size: 22px;
            }

            .section {
                padding: 20px;
            }

            .skills {
                gap: 8px;
            }

            .skill {
                padding: 8px 13px;

                font-size: 13px;
            }

            .back {
                width: 100%;

                text-align: center;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- =========================================
             PAGE TITLE
        ========================================= -->

        <h1>
            ■ ATS Resume Scanner
        </h1>

        <hr>


        <!-- =========================================
             STUDENT INFORMATION
        ========================================= -->

        <div class="student-info">

            <h2>
                Student: <%= student.fullname %>
            </h2>

            <p>
                <strong>USN:</strong>
                <%= student.usn %>
            </p>

            <p>
                <strong>Company:</strong>
                <%= drive.company %>
            </p>

            <p>
                <strong>Role:</strong>
                <%= drive.role %>
            </p>

        </div>


        <!-- =========================================
             ATS SCORE
        ========================================= -->

        <div class="score-box">

            <div class="score-label">
                ATS Compatibility Score
            </div>

            <div class="score">
                <%= ats.score %>%
            </div>

            <div class="result">
                <%= ats.result %>
            </div>

        </div>


        <!-- =========================================
             RESUME SKILLS
        ========================================= -->

        <div class="section">

            <h2>
                Skills Found in Resume
            </h2>

            <% if (ats.resumeSkills && ats.resumeSkills.length > 0) { %>

                <div class="skills">

                    <% ats.resumeSkills.forEach(function(skill) { %>

                        <span class="skill resume-skill">
                            ✓ <%= skill %>
                        </span>

                    <% }); %>

                </div>

            <% } else { %>

                <p>
                    No technical skills detected in resume.
                </p>

            <% } %>

        </div>


        <!-- =========================================
             REQUIRED SKILLS
        ========================================= -->

        <div class="section">

            <h2>
                Skills Required by Company
            </h2>

            <% if (ats.requiredSkills && ats.requiredSkills.length > 0) { %>

                <div class="skills">

                    <% ats.requiredSkills.forEach(function(skill) { %>

                        <span class="skill required-skill">
                            <%= skill %>
                        </span>

                    <% }); %>

                </div>

            <% } else { %>

                <p>
                    No skills found in job description.
                </p>

            <% } %>

        </div>


        <!-- =========================================
             MATCHED SKILLS
        ========================================= -->

        <div class="section">

            <h2>
                Matched Skills
            </h2>

            <% if (ats.matchedSkills && ats.matchedSkills.length > 0) { %>

                <div class="skills">

                    <% ats.matchedSkills.forEach(function(skill) { %>

                        <span class="skill matched">
                            ✓ <%= skill %>
                        </span>

                    <% }); %>

                </div>

            <% } else { %>

                <p>
                    No matching skills found.
                </p>

            <% } %>

        </div>


        <!-- =========================================
             MISSING SKILLS
        ========================================= -->

        <div class="section">

            <h2>
                Unmatched / Missing Skills
            </h2>

            <% if (ats.missingSkills && ats.missingSkills.length > 0) { %>

                <div class="skills">

                    <% ats.missingSkills.forEach(function(skill) { %>

                        <span class="skill missing">
                            ✗ <%= skill %>
                        </span>

                    <% }); %>

                </div>

            <% } else { %>

                <p>
                    No missing skills.
                </p>

            <% } %>

        </div>


        <hr>


        <!-- =========================================
             BACK
        ========================================= -->

        <a href="/hr/dashboard" class="back">
            ← Back to HR Dashboard
        </a>

    </div>

</body>

</html>
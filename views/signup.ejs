<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Admin Registration</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        /* =========================================
           TOKENS
        ========================================= */

        :root {
            --ink: #0B1F3A;
            --ink-2: #12294A;

            --parchment: #F6F4EE;
            --paper: #FFFFFF;

            --brass: #AD8A54;
            --brass-light: #E4D6B8;

            --slate: #5B6B7C;
            --hairline: #E2DDD0;

            --ledger-green: #1F6E45;
            --error: #9A2E2E;

            --font-display: "Fraunces", Georgia, serif;
            --font-body: "Inter", "Segoe UI", Arial, sans-serif;
        }


        /* =========================================
           GLOBAL
        ========================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;

            font-family: var(--font-body);

            display: flex;

            justify-content: center;
            align-items: center;

            padding: 30px;

            background:
                linear-gradient(
                    90deg,
                    rgba(5, 22, 48, 0.95),
                    rgba(5, 22, 48, 0.78)
                ),
                url("/images/placement-bg.jpg");

            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }


        /* =========================================
           REGISTER CARD
        ========================================= */

        .register-container {
            width: 100%;
            max-width: 460px;

            background: var(--paper);

            border-radius: 20px;

            padding: 42px;

            box-shadow:
                0 25px 70px rgba(0, 0, 0, 0.35);
        }


        /* =========================================
           HEADER
        ========================================= */

        .register-header {
            margin-bottom: 30px;
        }

        .register-header h1 {
            font-family: var(--font-display);

            color: var(--ink);

            font-size: 31px;

            font-weight: 600;

            margin-bottom: 8px;
        }

        .register-header p {
            color: var(--slate);

            font-size: 14px;

            line-height: 1.6;
        }


        /* =========================================
           FORM
        ========================================= */

        .input-box {
            margin-bottom: 20px;
        }

        .input-box label {
            display: block;

            color: var(--ink);

            font-size: 13px;

            font-weight: 700;

            margin-bottom: 8px;
        }

        .input-box input {
            width: 100%;

            height: 50px;

            border-radius: 9px;

            border: 1px solid var(--hairline);

            background: var(--parchment);

            padding: 0 15px;

            color: var(--ink);

            font-family: var(--font-body);

            font-size: 14px;

            outline: none;

            transition: 0.25s;
        }

        .input-box input::placeholder {
            color: #8A96A3;
        }

        .input-box input:focus {
            background: var(--paper);

            border-color: var(--brass);

            box-shadow:
                0 0 0 3px rgba(173, 138, 84, 0.15);
        }


        /* =========================================
           ERROR MESSAGE
        ========================================= */

        .error {
            background: #fff1f0;

            color: var(--error);

            padding: 12px 14px;

            border-radius: 8px;

            margin-bottom: 20px;

            font-size: 13px;

            line-height: 1.5;

            border: 1px solid #ffcdd2;
        }


        /* =========================================
           REGISTER BUTTON
        ========================================= */

        button {
            width: 100%;

            height: 50px;

            border: none;

            border-radius: 9px;

            cursor: pointer;

            color: white;

            font-family: var(--font-body);

            font-size: 15px;

            font-weight: 700;

            background: var(--ink);

            transition: 0.3s;
        }

        button:hover {
            background: var(--brass);

            transform: translateY(-2px);

            box-shadow:
                0 10px 25px rgba(0, 0, 0, 0.20);
        }

        button:active {
            transform: translateY(0);
        }


        /* =========================================
           LOGIN LINK
        ========================================= */

        .login-link {
            text-align: center;

            margin-top: 25px;

            padding-top: 20px;

            border-top: 1px solid var(--hairline);

            color: var(--slate);

            font-size: 14px;
        }

        .login-link a {
            color: var(--brass);

            text-decoration: none;

            font-weight: 700;

            margin-left: 4px;

            transition: 0.2s;
        }

        .login-link a:hover {
            color: var(--ink);

            text-decoration: underline;
        }


        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 600px) {

            body {
                padding: 20px 12px;

                align-items: flex-start;
            }

            .register-container {
                margin-top: 25px;

                padding: 30px 22px;

                border-radius: 16px;
            }

            .register-header h1 {
                font-size: 27px;
            }

            .register-header p {
                font-size: 13px;
            }

        }


        @media (max-width: 380px) {

            .register-container {
                padding: 25px 18px;
            }

            .register-header h1 {
                font-size: 24px;
            }

            .input-box input {
                height: 48px;
            }

            button {
                height: 48px;
            }

        }

    </style>

</head>


<body>

    <div class="register-container">


        <!-- =========================================
             HEADER
        ========================================= -->

        <div class="register-header">

            <h1>
                Create Admin Account
            </h1>

            <p>
                Register to manage Campus Placement Portal
            </p>

        </div>


        <!-- =========================================
             REGISTRATION FORM
        ========================================= -->

        <form
            action="/register"
            method="POST"
        >

            <% if (typeof error !== "undefined" && error) { %>

                <div class="error">
                    <%= error %>
                </div>

            <% } %>


            <!-- FULL NAME -->

            <div class="input-box">

                <label for="name">
                    Full Name
                </label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your full name"
                    autocomplete="name"
                    required
                >

            </div>


            <!-- EMAIL -->

            <div class="input-box">

                <label for="email">
                    Email Address
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    autocomplete="email"
                    required
                >

            </div>


            <!-- PASSWORD -->

            <div class="input-box">

                <label for="password">
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Create password"
                    autocomplete="new-password"
                    minlength="6"
                    required
                >

            </div>


            <!-- REGISTER -->

            <button type="submit">
                Register
            </button>

        </form>


        <!-- =========================================
             LOGIN
        ========================================= -->

        <div class="login-link">

            Already registered?

            <a href="/">
                Login Here
            </a>

        </div>


    </div>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Campus Placement Portal</title>

    <link rel="stylesheet" href="/login.css">

</head>

<body>

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <header class="portal-header">

        <div class="header-content">

            <div class="logo-area">

                <div class="portal-logo">
                    CP
                </div>

                <div>
                    <h1>Campus Placement</h1>
                    <span>Office of Career Services</span>
                </div>

            </div>

           

        </div>

    </header>


    <!-- ========================= -->
    <!-- MAIN -->
    <!-- ========================= -->

    <main>

        <!-- ========================= -->
        <!-- HERO -->
        <!-- ========================= -->

        <section class="hero-section">

            <div class="hero-content">

                <!-- LEFT SIDE -->

                <div class="hero-text">

                    <span class="welcome-label">
                        RECRUITMENT CYCLE 2026
                    </span>

                    <h2>
                        Where placement records meet
                        <span>real opportunity.</span>
                    </h2>

                    <p>
                        Sign in to view your placement status,
                        track applications and connect with the
                        companies recruiting on campus this season.
                    </p>

                    <div class="feature-list">

                        <div class="feature-item">
                            <span class="feature-number">01</span>
                            <div>
                                <strong>Placement Drives</strong>
                                <small>Discover active recruitment opportunities</small>
                            </div>
                        </div>

                        <div class="feature-item">
                            <span class="feature-number">02</span>
                            <div>
                                <strong>Applications</strong>
                                <small>Track your placement applications</small>
                            </div>
                        </div>

                        <div class="feature-item">
                            <span class="feature-number">03</span>
                            <div>
                                <strong>Interview Scheduling</strong>
                                <small>Manage interview opportunities</small>
                            </div>
                        </div>

                    </div>

                </div>


                <!-- ========================= -->
                <!-- LOGIN CARD -->
                <!-- ========================= -->

                <div class="login-card">

                    <div class="login-card-header">

                        <div class="login-icon">
                            →
                        </div>

                        <div>
                            <span class="card-label">
                                ACCOUNT ACCESS
                            </span>

                            <h2>
                                Sign In
                            </h2>

                            <p>
                                Access your placement account
                            </p>
                        </div>

                    </div>


                    <form action="/login"
                          method="POST">

                        <div class="form-group">

                            <label>
                                Email Address
                            </label>

                            <input
                                type="email"
                                name="email"
                                placeholder="you@college.edu"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label>
                                Password / USN
                            </label>

                            <input
                                type="password"
                                name="password"
                                placeholder="Enter password or USN"
                                required
                            >

                        </div>


                        <% if (error) { %>

                            <div class="error-message">

                                <span>!</span>

                                <%= error %>

                            </div>

                        <% } %>


                        <button
                            type="submit"
                            class="login-button">

                            <span>Sign In</span>

                            <span class="button-arrow">
                                →
                            </span>

                        </button>

                    </form>


                    <div class="register-section">

                        <span>
                            New administrator?
                        </span>

                        <a href="/register">
                            Register Admin →
                        </a>

                    </div>

                </div>

            </div>

        </section>


        <!-- ========================= -->
        <!-- COMPANIES -->
        <!-- ========================= -->

        <section class="companies-section">

            <div class="section-heading">

                <span>
                    CAREER OPPORTUNITIES
                </span>

                <h2>
                    Current Placement Opportunities
                </h2>

                <p>
                    Explore companies currently recruiting
                    through the campus placement programme.
                </p>

            </div>


            <% if (companiesList &&
                   companiesList.length > 0) { %>


                <!-- COMPANY LIST -->

                <div class="companies-list">

                    <% companiesList.forEach((company, index) => { %>

                        <div class="company-card">

                            <!-- NUMBER -->

                            <div class="company-number">

                                <span>
                                    <%= String(index + 1).padStart(2, "0") %>
                                </span>

                            </div>


                            <!-- LOGO -->

                            <div class="company-logo-wrapper">

                                <% if (company.logo) { %>

                                    <img
                                        src="/company/logo/<%= company._id %>"
                                        alt="<%= company.company %>"
                                        class="company-logo"
                                    >

                                <% } else { %>

                                    <div class="default-logo">
                                        🏢
                                    </div>

                                <% } %>

                            </div>


                            <!-- COMPANY INFORMATION -->

                            <div class="company-main">

                                <span class="company-label">
                                    COMPANY
                                </span>

                                <h3>
                                    <%= company.company %>
                                </h3>

                            </div>


                            <!-- ROLE -->

                            <div class="company-detail">

                                <span class="detail-label">
                                    POSITION
                                </span>

                                <span class="detail-value">

                                    <%= company.role ||
                                        "Not specified" %>

                                </span>

                            </div>


                            <!-- PACKAGE -->

                            <div class="company-detail package-detail">

                                <span class="detail-label">
                                    PACKAGE
                                </span>

                                <span class="package-value">

                                    <%= company.package ||
                                        "Not specified" %>

                                </span>

                            </div>


                            <!-- ARROW -->

                            <div class="company-arrow">
                                →
                            </div>

                        </div>

                    <% }) %>

                </div>


            <% } else { %>


                <!-- NO COMPANIES -->

                <div class="no-companies">

                    <div class="no-company-icon">
                        🏢
                    </div>

                    <h3>
                        No Placement Companies
                    </h3>

                    <p>
                        Placement opportunities will appear
                        here once companies are added.
                    </p>

                </div>


            <% } %>

        </section>

    </main>


    <!-- ========================= -->
    <!-- FOOTER -->
    <!-- ========================= -->

    <footer>

        <div class="footer-inner">

            <div>

                <strong>
                    Campus Placement Portal
                </strong>

                <span>
                    Connecting Students with Opportunities
                </span>

            </div>

            <p>
                © 2026
            </p>

        </div>

    </footer>

</body>

</html>
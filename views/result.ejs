<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Result</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        /* =========================
           TOKENS
        ========================= */

        :root {
            --ink: #0B1F3A;
            --ink-2: #12294A;
            --parchment: #F6F4EE;
            --paper: #FFFFFF;
            --brass: #AD8A54;
            --brass-light: #E4D6B8;
            --slate: #5B6B7C;
            --hairline: #E2DDD0;
            --ledger-green: #1F6E45;
            --error: #9A2E2E;

            --font-display: "Fraunces", Georgia, serif;
            --font-body: "Inter", "Segoe UI", Arial, sans-serif;
        }


        /* =========================
           GLOBAL
        ========================= */

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;

            font-family: var(--font-body);

            background:
                linear-gradient(
                    rgba(10, 30, 55, 0.90),
                    rgba(10, 30, 55, 0.90)
                ),
                url("/images/students-placement.jpg");

            background-size: cover;
            background-position: center;
            background-attachment: fixed;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 40px 20px;

            color: var(--ink);
        }


        /* =========================
           MAIN CONTAINER
        ========================= */

        .result-container {
            width: 100%;
            max-width: 800px;

            background: rgba(255, 255, 255, 0.98);

            padding: 40px;

            border-radius: 18px;

            box-shadow:
                0 20px 50px rgba(0, 0, 0, 0.35);
        }


        /* =========================
           HEADER
        ========================= */

        .page-header {
            text-align: center;

            margin-bottom: 30px;
        }

        .page-header h1 {
            font-family: var(--font-display);

            color: var(--ink);

            font-size: 32px;

            margin-bottom: 8px;
        }

        .page-header p {
            color: var(--slate);

            font-size: 14px;
        }

        .student-usn {
            color: var(--brass);

            font-weight: 700;
        }


        /* =========================
           DIVIDER
        ========================= */

        .divider {
            border: none;

            height: 1px;

            background: var(--hairline);

            margin: 25px 0 30px;
        }


        /* =========================
           FORM
        ========================= */

        form {
            width: 100%;
        }


        /* =========================
           SEMESTER / PERCENTAGE / CGPA
        ========================= */

        .academic-grid {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 15px;

            margin-bottom: 25px;
        }

        .field-group {
            display: flex;

            flex-direction: column;

            gap: 7px;
        }

        .field-group label {
            color: var(--ink);

            font-size: 13px;

            font-weight: 700;
        }

        input {
            width: 100%;

            padding: 13px 14px;

            border: 1px solid var(--hairline);

            border-radius: 8px;

            outline: none;

            font-family: var(--font-body);

            font-size: 14px;

            color: var(--ink);

            background: var(--parchment);

            transition: 0.25s;
        }

        input::placeholder {
            color: #8A96A3;
        }

        input:focus {
            border-color: var(--brass);

            background: white;

            box-shadow:
                0 0 0 3px rgba(173, 138, 84, 0.15);
        }


        /* =========================
           SUBJECT SECTION
        ========================= */

        .section-title {
            font-family: var(--font-display);

            color: var(--ink);

            font-size: 22px;

            border-left: 5px solid var(--ink);

            padding-left: 12px;

            margin-bottom: 18px;
        }


        /* =========================
           SUBJECT ROW
        ========================= */

        .subject-row {
            display: grid;

            grid-template-columns: 1fr 180px;

            gap: 15px;

            margin-bottom: 15px;
        }


        /* =========================
           SAVE BUTTON
        ========================= */

        button {
            width: 100%;

            padding: 14px 20px;

            margin-top: 15px;

            border: none;

            border-radius: 8px;

            background: var(--ink);

            color: white;

            font-family: var(--font-body);

            font-size: 15px;

            font-weight: 700;

            cursor: pointer;

            transition: 0.3s;
        }

        button:hover {
            background: var(--brass);

            transform: translateY(-2px);

            box-shadow:
                0 7px 18px rgba(0, 0, 0, 0.18);
        }

        button:active {
            transform: translateY(0);
        }


        /* =========================
           BACK LINK
        ========================= */

        .back-link {
            text-align: center;

            margin-top: 25px;
        }

        .back-link a {
            color: var(--brass);

            text-decoration: none;

            font-size: 14px;

            font-weight: 700;

            transition: 0.2s;
        }

        .back-link a:hover {
            color: var(--ink);

            text-decoration: underline;
        }


        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 700px) {

            body {
                padding: 20px 10px;

                align-items: flex-start;
            }

            .result-container {
                margin: 20px 0;

                padding: 28px 20px;

                border-radius: 14px;
            }

            .page-header h1 {
                font-size: 27px;
            }

            .academic-grid {
                grid-template-columns: 1fr;
            }

            .subject-row {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .section-title {
                font-size: 20px;
            }
        }


        @media (max-width: 400px) {

            .result-container {
                padding: 22px 15px;
            }

            .page-header h1 {
                font-size: 24px;
            }

            input {
                padding: 12px;
            }

            button {
                padding: 13px;
            }
        }

    </style>

</head>


<body>

    <div class="result-container">

        <!-- =========================
             PAGE HEADER
        ========================= -->

        <div class="page-header">

            <h1>
                Add Student Result
            </h1>

            <p>
                Student USN:
                <span class="student-usn">
                    <%= student.usn %>
                </span>
            </p>

        </div>


        <hr class="divider">


        <!-- =========================
             RESULT FORM
        ========================= -->

        <form
            action="/result/<%= student.usn %>"
            method="POST"
        >


            <!-- =========================
                 ACADEMIC INFORMATION
            ========================= -->

            <div class="academic-grid">

                <div class="field-group">

                    <label for="semester">
                        Semester
                    </label>

                    <input
                        type="number"
                        id="semester"
                        name="semester"
                        placeholder="e.g. 5"
                        min="1"
                        max="8"
                        required
                    >

                </div>


                <div class="field-group">

                    <label for="percentage">
                        Percentage
                    </label>

                    <input
                        type="number"
                        id="percentage"
                        name="percentage"
                        placeholder="e.g. 85.50"
                        min="0"
                        max="100"
                        step="0.01"
                        required
                    >

                </div>


                <div class="field-group">

                    <label for="cgpa">
                        CGPA
                    </label>

                    <input
                        type="number"
                        id="cgpa"
                        name="cgpa"
                        placeholder="e.g. 8.50"
                        min="0"
                        max="10"
                        step="0.01"
                        required
                    >

                </div>

            </div>


            <!-- =========================
                 SUBJECTS
            ========================= -->

            <h2 class="section-title">
                Subject Marks
            </h2>


            <!-- SUBJECT 1 -->

            <div class="subject-row">

                <input
                    type="text"
                    name="sub1"
                    placeholder="Subject 1"
                    required
                >

                <input
                    type="number"
                    name="mark1"
                    placeholder="Marks"
                    min="0"
                    max="100"
                    required
                >

            </div>


            <!-- SUBJECT 2 -->

            <div class="subject-row">

                <input
                    type="text"
                    name="sub2"
                    placeholder="Subject 2"
                    required
                >

                <input
                    type="number"
                    name="mark2"
                    placeholder="Marks"
                    min="0"
                    max="100"
                    required
                >

            </div>


            <!-- SUBJECT 3 -->

            <div class="subject-row">

                <input
                    type="text"
                    name="sub3"
                    placeholder="Subject 3"
                    required
                >

                <input
                    type="number"
                    name="mark3"
                    placeholder="Marks"
                    min="0"
                    max="100"
                    required
                >

            </div>


            <!-- SUBJECT 4 -->

            <div class="subject-row">

                <input
                    type="text"
                    name="sub4"
                    placeholder="Subject 4"
                    required
                >

                <input
                    type="number"
                    name="mark4"
                    placeholder="Marks"
                    min="0"
                    max="100"
                    required
                >

            </div>


            <!-- SUBJECT 5 -->

            <div class="subject-row">

                <input
                    type="text"
                    name="sub5"
                    placeholder="Subject 5"
                    required
                >

                <input
                    type="number"
                    name="mark5"
                    placeholder="Marks"
                    min="0"
                    max="100"
                    required
                >

            </div>


            <!-- SUBJECT 6 -->

            <div class="subject-row">

                <input
                    type="text"
                    name="sub6"
                    placeholder="Subject 6"
                    required
                >

                <input
                    type="number"
                    name="mark6"
                    placeholder="Marks"
                    min="0"
                    max="100"
                    required
                >

            </div>


            <!-- =========================
                 SUBMIT
            ========================= -->

            <button type="submit">
                Save Student Result
            </button>

        </form>


        <!-- =========================
             BACK
        ========================= -->

        <div class="back-link">

            <a href="/admin">
                ← Back to Dashboard
            </a>

        </div>

    </div>

</body>

</html>
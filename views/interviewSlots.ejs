<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Select Interview Slot</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>
        /* =========================================
           TOKENS
        ========================================= */

        :root {
            --ink: #0B1F3A;
            --ink-2: #12294A;

            --parchment: #F6F4EE;
            --paper: #FFFFFF;

            --brass: #AD8A54;
            --brass-light: #E4D6B8;

            --slate: #5B6B7C;

            --hairline: #E2DDD0;

            --ledger-green: #1F6E45;
            --error: #9A2E2E;

            --font-display: "Fraunces", "Iowan Old Style", Georgia, serif;
            --font-body: "Inter", "Segoe UI", Arial, sans-serif;
        }

        /* =========================================
           GLOBAL
        ========================================= */

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            font-family: var(--font-body);
            color: var(--ink);

            background:
                linear-gradient(
                    rgba(8, 28, 50, 0.90),
                    rgba(8, 28, 50, 0.90)
                ),
                url("/images/students-placement.jpg");

            background-size: cover;
            background-position: center;
            background-attachment: fixed;

            padding: 40px 20px;
        }

        /* =========================================
           MAIN CONTAINER
        ========================================= */

        .container {
            width: 90%;
            max-width: 900px;

            margin: 30px auto;

            background: rgba(255, 255, 255, 0.98);

            padding: 35px;

            border-radius: 16px;

            box-shadow:
                0 15px 40px rgba(0, 0, 0, 0.25);
        }

        /* =========================================
           PAGE TITLE
        ========================================= */

        .page-title {
            margin: 0 0 30px;

            text-align: center;

            color: var(--ink);

            font-family: var(--font-display);

            font-size: 30px;
            font-weight: 600;

            letter-spacing: 1px;
        }

        /* =========================================
           DRIVE INFORMATION
        ========================================= */

        .drive {
            background: var(--parchment);

            border: 1px solid var(--hairline);
            border-left: 5px solid var(--ink);

            border-radius: 10px;

            padding: 22px;

            margin-bottom: 28px;

            text-align: center;
        }

        .drive h2 {
            margin: 0 0 12px;

            color: var(--ink);

            font-family: var(--font-display);

            font-size: 24px;
        }

        .drive p {
            margin: 8px 0;

            color: var(--slate);

            font-size: 15px;
        }

        .drive strong {
            color: var(--ledger-green);

            font-size: 17px;
        }

        /* =========================================
           SECTION TITLE
        ========================================= */

        .section-title {
            margin: 25px 0 18px;

            padding-left: 12px;

            border-left: 5px solid var(--ink);

            color: var(--ink);

            font-family: var(--font-display);

            font-size: 22px;
        }

        /* =========================================
           INTERVIEW SLOT
        ========================================= */

        .slot {
            background: var(--paper);

            border: 1px solid var(--hairline);
            border-left: 5px solid var(--ink);

            padding: 22px;

            margin: 15px 0;

            border-radius: 12px;

            box-shadow:
                0 5px 15px rgba(0, 0, 0, 0.08);

            transition: all 0.25s ease;
        }

        .slot:hover {
            transform: translateY(-4px);

            box-shadow:
                0 10px 25px rgba(0, 0, 0, 0.14);
        }

        /* =========================================
           SLOT TITLE
        ========================================= */

        .slot h3 {
            margin: 0 0 15px;

            color: var(--ink);

            font-family: var(--font-display);

            font-size: 20px;
        }

        /* =========================================
           SLOT DETAILS
        ========================================= */

        .slot-details {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 12px;

            margin: 15px 0 18px;
        }

        .slot-detail {
            background: var(--parchment);

            padding: 14px;

            border: 1px solid var(--hairline);

            border-radius: 8px;

            text-align: center;
        }

        .slot-detail-label {
            display: block;

            margin-bottom: 5px;

            color: var(--ink);

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 0.8px;
        }

        .slot-detail-value {
            color: var(--slate);

            font-size: 14px;

            font-weight: 700;
        }

        /* =========================================
           SELECT BUTTON
        ========================================= */

        .select-btn {
            width: 100%;

            padding: 13px 22px;

            margin-top: 5px;

            border: none;

            border-radius: 7px;

            background: var(--ink);

            color: white;

            font-family: var(--font-body);

            font-size: 14px;

            font-weight: 700;

            cursor: pointer;

            transition: all 0.25s ease;
        }

        .select-btn:hover {
            background: var(--brass);

            transform: translateY(-2px);

            box-shadow:
                0 6px 15px rgba(173, 138, 84, 0.25);
        }

        .select-btn:active {
            transform: translateY(0);
        }

        /* =========================================
           NO SLOT MESSAGE
        ========================================= */

        .no-slot {
            background: var(--parchment);

            border: 1px solid var(--hairline);

            border-radius: 10px;

            padding: 30px;

            margin-top: 20px;

            text-align: center;
        }

        .no-slot-icon {
            margin-bottom: 10px;

            color: var(--brass);

            font-size: 36px;
        }

        .no-slot h3 {
            margin: 5px 0 10px;

            color: var(--ink);

            font-family: var(--font-display);
        }

        .no-slot p {
            margin: 0;

            color: var(--slate);

            font-size: 14px;
        }

        /* =========================================
           BACK BUTTON
        ========================================= */

        .back-btn {
            display: inline-block;

            margin-top: 25px;

            padding: 10px 20px;

            background: var(--slate);

            color: white;

            border-radius: 7px;

            text-decoration: none;

            font-size: 14px;
            font-weight: 700;

            transition: all 0.25s ease;
        }

        .back-btn:hover {
            background: var(--ink);

            transform: translateY(-2px);
        }

        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 600px) {

            body {
                padding: 20px 10px;
            }

            .container {
                width: 94%;

                padding: 22px 18px;

                margin: 20px auto;
            }

            .page-title {
                font-size: 24px;

                margin-bottom: 24px;
            }

            .drive {
                padding: 18px;
            }

            .drive h2 {
                font-size: 21px;
            }

            .slot {
                padding: 18px;
            }

            .slot-details {
                grid-template-columns: 1fr;

                gap: 8px;
            }

            .slot-detail {
                display: flex;

                justify-content: space-between;
                align-items: center;

                text-align: left;
            }

            .slot-detail-label {
                margin: 0;
            }

            .select-btn {
                width: 100%;
            }

            .back-btn {
                width: 100%;

                text-align: center;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- PAGE TITLE -->

        <h1 class="page-title">
            Select Interview Slot
        </h1>


        <!-- DRIVE INFORMATION -->

        <div class="drive">

            <h2>
                <%= drive.company %>
            </h2>

            <p>
                <strong>Role:</strong>
                <%= drive.role %>
            </p>

            <p>
                ATS Score:
                <strong>
                    <%= application.atsScore %>%
                </strong>
            </p>

        </div>


        <!-- AVAILABLE SLOTS -->

        <h2 class="section-title">
            Available Interview Slots
        </h2>


        <% if (slots && slots.length > 0) { %>

            <% slots.forEach(slot => { %>

                <div class="slot">

                    <h3>
                        ■ Interview Slot
                    </h3>


                    <div class="slot-details">

                        <div class="slot-detail">

                            <span class="slot-detail-label">
                                DATE
                            </span>

                            <span class="slot-detail-value">
                                <%= slot.date %>
                            </span>

                        </div>


                        <div class="slot-detail">

                            <span class="slot-detail-label">
                                TIME
                            </span>

                            <span class="slot-detail-value">
                                <%= slot.time %>
                            </span>

                        </div>


                        <div class="slot-detail">

                            <span class="slot-detail-label">
                                MODE
                            </span>

                            <span class="slot-detail-value">
                                <%= slot.mode %>
                            </span>

                        </div>

                    </div>


                    <form
                        action="/student/interview-slots/book"
                        method="POST"
                    >

                        <input
                            type="hidden"
                            name="slotId"
                            value="<%= slot._id %>"
                        >

                        <input
                            type="hidden"
                            name="driveId"
                            value="<%= drive._id %>"
                        >

                        <button
                            type="submit"
                            class="select-btn"
                        >
                            SELECT THIS SLOT
                        </button>

                    </form>

                </div>

            <% }) %>

        <% } else { %>

            <div class="no-slot">

                <div class="no-slot-icon">
                    ■
                </div>

                <h3>
                    No Interview Slots Available
                </h3>

                <p>
                    Please check again later for available interview slots.
                </p>

            </div>

        <% } %>


        <!-- BACK BUTTON -->

        <a
            href="/student/dashboard"
            class="back-btn"
        >
            ← Back to Dashboard
        </a>

    </div>

</body>

</html>
<!DOCTYPE html>

<html lang="en">

<head>

```
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Select Interview Slot</title>

<style>

    /* =========================
       GLOBAL
    ========================= */

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        color: #1f2937;

        background:
            linear-gradient(
                rgba(8, 28, 50, 0.88),
                rgba(8, 28, 50, 0.88)
            ),
            url("/images/students-placement.jpg");

        background-size: cover;

        background-position: center;

        background-attachment: fixed;

        min-height: 100vh;

        padding: 40px 20px;
    }


    /* =========================
       MAIN CONTAINER
    ========================= */

    .container {
        width: 90%;

        max-width: 900px;

        margin: 30px auto;

        background: rgba(255, 255, 255, 0.97);

        padding: 35px;

        border-radius: 14px;

        box-shadow:
            0 8px 25px rgba(0, 0, 0, 0.2);
    }


    /* =========================
       PAGE TITLE
    ========================= */

    .page-title {
        text-align: center;

        color: #12395b;

        font-size: 30px;

        text-transform: uppercase;

        letter-spacing: 1px;

        margin-top: 0;

        margin-bottom: 30px;
    }


    /* =========================
       DRIVE INFORMATION
    ========================= */

    .drive {
        background: #f8fafc;

        border: 1px solid #e5e7eb;

        border-left: 5px solid #1769aa;

        border-radius: 10px;

        padding: 22px;

        margin-bottom: 25px;

        text-align: center;
    }

    .drive h2 {
        margin-top: 0;

        color: #1769aa;

        font-size: 24px;

        margin-bottom: 10px;
    }

    .drive p {
        color: #374151;

        margin: 8px 0;

        font-size: 15px;
    }

    .drive strong {
        color: #047857;

        font-size: 18px;
    }


    /* =========================
       SECTION TITLE
    ========================= */

    .section-title {
        color: #12395b;

        font-size: 22px;

        border-left: 5px solid #1769aa;

        padding-left: 12px;

        margin: 25px 0 18px;
    }


    /* =========================
       INTERVIEW SLOT
    ========================= */

    .slot {
        background: white;

        border: 1px solid #e3e8ee;

        border-left: 5px solid #1769aa;

        padding: 22px;

        margin: 15px 0;

        border-radius: 12px;

        box-shadow:
            0 5px 15px rgba(0, 0, 0, 0.08);

        transition: 0.3s;
    }

    .slot:hover {
        transform: translateY(-4px);

        box-shadow:
            0 10px 25px rgba(0, 0, 0, 0.15);
    }


    /* =========================
       SLOT DATE
    ========================= */

    .slot h3 {
        color: #1769aa;

        font-size: 20px;

        margin-top: 0;

        margin-bottom: 12px;
    }


    /* =========================
       SLOT DETAILS
    ========================= */

    .slot-details {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 12px;

        margin: 15px 0;
    }

    .slot-detail {
        background: #f8fafc;

        padding: 12px;

        border-radius: 7px;

        border: 1px solid #e5e7eb;

        text-align: center;
    }

    .slot-detail-label {
        display: block;

        color: #12395b;

        font-size: 12px;

        font-weight: bold;

        margin-bottom: 5px;
    }

    .slot-detail-value {
        color: #374151;

        font-size: 14px;

        font-weight: bold;
    }


    /* =========================
       SELECT BUTTON
    ========================= */

    .select-btn {
        width: 100%;

        border: none;

        background: #1769aa;

        color: white;

        padding: 12px 22px;

        border-radius: 6px;

        cursor: pointer;

        font-weight: bold;

        font-size: 15px;

        margin-top: 10px;

        transition: 0.3s;
    }

    .select-btn:hover {
        background: #0d4f82;

        transform: translateY(-2px);
    }


    /* =========================
       NO SLOT MESSAGE
    ========================= */

    .no-slot {
        background: #f8fafc;

        border: 1px solid #e5e7eb;

        border-radius: 10px;

        padding: 30px;

        text-align: center;

        margin-top: 20px;
    }

    .no-slot-icon {
        font-size: 40px;

        margin-bottom: 10px;
    }

    .no-slot h3 {
        color: #12395b;

        margin: 5px 0 10px;
    }

    .no-slot p {
        color: #667085;

        margin: 0;
    }


    /* =========================
       BACK BUTTON
    ========================= */

    .back-btn {
        display: inline-block;

        margin-top: 25px;

        background: #6b7280;

        color: white;

        text-decoration: none;

        padding: 10px 20px;

        border-radius: 6px;

        font-weight: bold;

        transition: 0.3s;
    }

    .back-btn:hover {
        background: #4b5563;

        transform: translateY(-2px);
    }


    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 600px) {

        body {
            padding: 20px 10px;
        }

        .container {
            width: 94%;

            padding: 22px;
        }

        .page-title {
            font-size: 24px;
        }

        .drive h2 {
            font-size: 21px;
        }

        .slot {
            padding: 18px;
        }

        .slot-details {
            grid-template-columns: 1fr;
        }

        .select-btn {
            width: 100%;
        }

    }

</style>
```

</head>

<body>

<div class="container">

```
<!-- =========================
     PAGE TITLE
========================= -->

<h1 class="page-title">
    Select Interview Slot
</h1>


<!-- =========================
     DRIVE INFORMATION
========================= -->

<div class="drive">

    <h2>
        <%= drive.company %>
    </h2>

    <p>
        <strong>Role:</strong>
        <%= drive.role %>
    </p>

    <p>
        ATS Score:
        <strong>
            <%= application.atsScore %>%
        </strong>
    </p>

</div>


<!-- =========================
     AVAILABLE SLOTS
========================= -->

<h2 class="section-title">
    Available Interview Slots
</h2>


<% if (slots.length === 0) { %>


    <div class="no-slot">

        <div class="no-slot-icon">
            📅
        </div>

        <h3>
            No Interview Slots Available
        </h3>

        <p>
            Please check again later for available interview slots.
        </p>

    </div>


<% } else { %>


    <% slots.forEach(slot => { %>


        <div class="slot">


            <h3>
                📅 Interview Slot
            </h3>


            <div class="slot-details">


                <div class="slot-detail">

                    <span class="slot-detail-label">
                        DATE
                    </span>

                    <span class="slot-detail-value">
                        <%= slot.date %>
                    </span>

                </div>


                <div class="slot-detail">

                    <span class="slot-detail-label">
                        TIME
                    </span>

                    <span class="slot-detail-value">
                        <%= slot.time %>
                    </span>

                </div>


                <div class="slot-detail">

                    <span class="slot-detail-label">
                        MODE
                    </span>

                    <span class="slot-detail-value">
                        <%= slot.mode %>
                    </span>

                </div>


            </div>


            <form
                action="/student/interview-slots/book"
                method="POST"
            >

                <input
                    type="hidden"
                    name="slotId"
                    value="<%= slot._id %>"
                >


                <input
                    type="hidden"
                    name="driveId"
                    value="<%= drive._id %>"
                >


                <button
                    type="submit"
                    class="select-btn"
                >
                    SELECT THIS SLOT
                </button>

            </form>


        </div>


    <% }) %>


<% } %>


<!-- =========================
     BACK BUTTON
========================= -->

<a
    href="/student/dashboard"
    class="back-btn"
>
    ← Back to Dashboard
</a>
```

</div>

</body>

</html>
